{
    "name": "comparative-reader-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@12.21.0",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "typecheck": "tsc -b --pretty",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "cd .. && husky frontend/.husky",
        "generate:api": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/api/schema.d.ts"
    },
    "dependencies": {
        "@fortawesome/free-regular-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/react-fontawesome": "^3.5.0",
        "@tanstack/react-query": "^5.107.1",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-router": "^8.5.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.4.21",
        "eslint": "^10.15.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2",
        "openapi-typescript": "^7.13.0",
        "postcss": "^8.5.6",
        "prettier": "^3.6.2",
        "tailwindcss": "^3.4.17",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^6.4.1",
        "vitest": "^5.1.0"
    },
    "lint-staged": {
        "*.{css,cjs,html,js,json,jsx,md,mjs,ts,tsx,yaml,yml}": "prettier --write"
    }
}
