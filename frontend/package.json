{
    "name": "comparative-reader-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@12.16.1",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --pretty",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "cd .. && husky frontend/.husky"
    },
    "dependencies": {
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-router": "^8.5.1",
        "vitest": "^5.1.0",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.4.21",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2",
        "postcss": "^8.5.6",
        "prettier": "^3.6.2",
        "tailwindcss": "^3.4.17",
        "typescript": "~5.8.3",
        "vite": "^6.4.1"
    },
    "lint-staged": {
        "*.{css,cjs,html,js,json,jsx,md,mjs,ts,tsx,yaml,yml}": "prettier --write"
    }
}
